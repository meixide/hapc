is_col_permutation <- function(A, B, tol = 0) {
if (!all(dim(A) == dim(B))) return(FALSE)
used <- rep(FALSE, ncol(B))
for (j in seq_len(ncol(A))) {
# find all candidate matches
matches <- which(apply(B, 2, function(bj)
isTRUE(all.equal(A[, j], bj, tolerance = tol))))
# choose one not yet used
matches <- matches[!used[matches]]
if (length(matches) == 0) return(FALSE)
used[matches[1]] <- TRUE
}
TRUE
}
setwd("~/Projects/hapc")
n <-100
d <- 5
X <- matrix(runif(n*d, 0, 1), n, d)
library('hal9001')
hal <- enumerate_basis(
x                   = X,
max_degree          = 2,
smoothness_orders   = rep(0, d),        # indicator basis
include_lower_order = TRUE
)
H      <- as.matrix(make_design_matrix(X,   hal, p_reserve = 1))  # n  × q
des=design.hapc(X,max_degree= 2 ,center= 0)
s=svd(H)
D=s$d
U=s$u
V=s$v
plot(des$U[,3],U[,3])
#is_col_permutation(H,des$H)
f1 = function(X,n)
sin(pi*(X[,1]*X[,3]))/X[,1] + sqrt(X[,2])*log(X[,3]) + rnorm(n, 0, 0.05)
f=f1
Y <- f(X,n)
nnew=100
Xnew=matrix(runif(nnew*d, 0.1, 1), ncol=d)
k=kernel.hapc(X,max_degree=2,center=F)
max(abs(des$H%*%t(des$H)-k)) # notice H is from hapc and not hal9001
max(abs(H%*%t(H)-k)) # notice H is from hapc and not hal9001
sk=eigen(k)
D2k=sk$values
Uk=sk$vectors
plot(Uk[,1],des$U[,1])
plot(Uk[,1],U[,1])
sqrt(D2k)
D
lambda=0.01
solve(lambda*n*diag(1,n) + diag(D^2))%*%diag(D)%*%t(U)%*%Y
desm=U%*%diag(D)
alphahand=solve(lambda*n*diag(1,n) + t(desm)%*%desm)%*%t(desm)%*%Y
res <- hapc(X, Y,family='gaussian',
npcs = n,
lambda=lambda,
norm = "2",
max_degree=2,
predict=Xnew,
center=0,approx=F
)
res$alpha
plot(alphahand,res$alpha)
library('glmnet')
lss=glmnet(desm,Y,alpha=1,lambda=lambda,standardize = FALSE,center=FALSE,intercept=FALSE)
coef(lss)[-1]
hand=sign(t(U)%*%Y)*pmax(0,abs(t(U)%*%Y) - lambda*n/D)/D
res <- hapc(X, Y,
npcs = n,
lambda=lambda,
norm = "1",
max_degree=2,
predict=Xnew,
center=0,approx=F
)
plot(res$alpha,hand)
plot(f(Xnew,nnew),res$predictions)
pkgbuild::compile_dll()
devtools::load_all()
is_col_permutation <- function(A, B, tol = 0) {
if (!all(dim(A) == dim(B))) return(FALSE)
used <- rep(FALSE, ncol(B))
for (j in seq_len(ncol(A))) {
# find all candidate matches
matches <- which(apply(B, 2, function(bj)
isTRUE(all.equal(A[, j], bj, tolerance = tol))))
# choose one not yet used
matches <- matches[!used[matches]]
if (length(matches) == 0) return(FALSE)
used[matches[1]] <- TRUE
}
TRUE
}
