plot(f(Xnew,nnew),res$predictions)
f <- function(X, n) {
sin(pi * (X[, 1] * X[, 3])) / X[, 1] +
sqrt(X[, 2]) * log(X[, 3]) +
rnorm(n, 0, 0.05)
}
# Generate training data
n <- 50
d <- 3
X <- matrix(runif(n * d, 0.1, 1), ncol = d)
Y <- f(X, n)
# Generate test data
nnew <- 100
Xnew <- matrix(runif(nnew * d, 0.1, 1), ncol = d)
# Fit HAPC model with L2 norm constraint
fit <- hapc(X, Y,
npcs = n,
lambda = 0.6,
norm = "2",
predict = Xnew)
predictions <- fit$predictions
plot(predictions,f(Xnew,nnew))
