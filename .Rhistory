nnew=1000
Xnew=matrix(runif(nnew*d, 0.1, 1), ncol=d)
Ynew = f(Xnew)
rescv <- cv.hapc(X, Y,
npcs = n,
log_lambda_min =-4,
log_lambda_max = -1,
norm = "1",
max_degree=d,
predict=Xnew
)
plot(rescv$lambdas,rescv$mses)
plot(Ynew,rescv$predictions,col='red')
